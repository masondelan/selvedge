#!/bin/sh
# Selvedge hook launcher for the Claude Code plugin.
#
# Referenced by hooks/hooks.json as
#   "${CLAUDE_PLUGIN_ROOT}"/bin/selvedge-plugin-hook <subcommand>
# for all three events — pretooluse (the gate), sessionstart and precompact
# (delivery). Delegates to the shared resolver to run Selvedge's
# `selvedge-hook` console script; passing the subcommand through keeps the
# config declarative and this script identical for every event.
#
# Latency note: pretooluse fires on every gated Edit/Write/Bash call. When
# Selvedge is pip-installed, the resolver's PATH-first branch runs it directly
# with no cold start. With only uvx/pipx available it pays a Python start each
# call (warm after the first, since uvx caches the environment) — the honest
# cost of the zero-install path; `pip install selvedge` removes it. The two
# delivery hooks fire once per session and once per compaction, so their cost
# is not on any hot path.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$dir/selvedge-resolve" selvedge-hook "$@"
